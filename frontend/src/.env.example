# ── Clerk Authentication ──────────────────────────────────────────────────────
# 1. Create an app at https://clerk.com
# 2. Dashboard → Configure → Social Connections → enable Google
# 3. Copy your Publishable Key below (starts with pk_test_ or pk_live_)
# 4. Add to Clerk Dashboard → Redirect URLs:
#      http://localhost:5173
#      https://your-app.netlify.app
#      https://conductorweb.com  (when live)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
